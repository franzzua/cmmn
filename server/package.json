{
	"name": "@cmmn/server",
	"version": "3.0.0-alpha-6",
	"description": "server libs for building rest api",
	"scripts": {
		"bundle": "vite build"
	},
	"repository": {
		"url": "https://github.com/franzzua/cmmn/tree/master/server"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/typings/index.d.ts",
				"default": "./dist/bundle/index.js"
			}
		}
	},
	"dependencies": {
		"@cmmn/core": "workspace:~",
		"fastify": "5.6.1"
	},
	"devDependencies": {
		"@cmmn/tools": "workspace:~"
	},
	"config": {
		"server": true
	},
	"type": "module",
	"author": "",
	"license": "ISC",
	"gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"files": [
		"dist/bundle/**",
		"dist/typings/**",
		"!dist/typings/specs/**",
		"!dist/typings/perf/**"
	]
