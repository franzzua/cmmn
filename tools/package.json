{
  "name": "@cmmn/tools",
  "version": "3.0.0-alpha-3",
  "description": "Compilation, bundling, code generator, testing.",
  "main": "dist/rollup.config.js",
  "type": "module",
  "repository": {
    "url": "https://github.com/franzzua/cmmn/tree/master/tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cmmn": "bin.js"
  },
  "exports": {
    "./compile/tsconfig.json": "./compile/tsconfig.json",
    "./import": "./node/register.js",
    "./test": "./test/test.ts"
  },
  "typesVersions": {
    "*": {
      "test": [
        "./test/index.d.ts"
      ],
      ".": [
        "./compile/typings.d.ts"
      ]
    }
  },
  "typings": "compile/typings.d.ts",
  "files": [
    "bin.js",
    "commands/**/*",
    "compile/*",
    "node/*",
    "test/*",
    "helpers/*"
  ],
  "dependencies": {
    "@biomejs/biome": "1.9.4",
    "@fastify/express": "^4.0.2",
    "@schemastore/package": "0.0.10",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "^0.6.0",
    "@swc/core": "1.10.7",
    "@swc/helpers": "0.5.15",
    "@types/node": "22.8.1",
    "@zerollup/ts-helpers": "1.7.18",
    "chokidar": "4.0.3",
    "expect": "^29.7.0",
    "express": "^4.21.2",
    "fastify": "5.2.1",
    "html-loader": "^5.1.0",
    "import-meta-resolve": "^4.1.0",
    "mime": "4.0.6",
    "terminal-kit": "^3.1.2",
    "unionfs": "^4.5.4",
    "unplugin": "^2.1.2",
    "unplugin-isolated-decl": "0.11.0",
    "unplugin-starter": "^0.1.0",
    "unplugin-swc": "^1.5.1",
    "vite": "6.0.11",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "author": "",
  "license": "ISC",
  "gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
  "stableVersion": "3.0.0-alpha-2",
  "resolutions": {
    "terser": "npm:@swc/core"
  },
  "devDependencies": {
    "@types/express": "^4"
  }
}
