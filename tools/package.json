{
	"name": "@cmmn/tools",
	"version": "3.0.0-E3",
	"description": "Compilation, bundling, code generator, testing.",
	"type": "module",
	"repository": {
		"url": "https://github.com/franzzua/cmmn/tree/master/tools"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"cmmn": "dist/esm/bin.js"
	},
	"scripts": {
		"compile": "node --import @cmmn/tools/import ./bin.ts compile -w .",
		"compile:watch": "node --import @cmmn/tools/import ./bin.ts compile --watch -w .",
		"dev": "cd .. && node --import @cmmn/tools/import ./tools/bin.ts dev --watch",
		"dev:prod": "cd .. && node --import @cmmn/tools/import ./tools/bin.ts dev --prod"
	},
	"exports": {
		".": "./index.ts",
		"./tsconfig.json": "./helpers/tsconfig.json",
		"./import": "./node/register.js",
		"./import-dev": "./node/register-dev.js",
		"./test": "./test/test.ts",
		"./swcrc": "./.swcrc"
	},
	"config": {
		"server": true
	},
	"files": [
		"dist",
		"node",
		".swcrc",
		"tsconfig.json"
	],
	"dependencies": {
		"@biomejs/biome": "1.9.4",
		"@fastify/caching": "9.0.3",
		"@fastify/express": "4.0.2",
		"@fastify/http-proxy": "11.3.0",
		"@manypkg/get-packages": "^2.2.2",
		"@rollup/plugin-wasm": "6.2.2",
		"@schemastore/package": "0.0.10",
		"@swc-node/register": "1.10.9",
		"@swc/core": "1.13.5",
		"@swc/helpers": "0.5.17",
		"@types/node": "22.18.9",
		"@yarn-tool/resolve-package": "^2.0.12",
		"@zerollup/ts-helpers": "1.7.18",
		"builtin-modules": "^5.0.0",
		"expect": "^29.7.0",
		"fast-glob": "^3.3.3",
		"fastify": "5.6.1",
		"http-proxy-middleware": "3.0.5",
		"mime-types": "2.1.35",
		"minimatch": "10.0.3",
		"rolldown": "1.0.0-beta.42",
		"terminal-kit": "^3.1.2",
		"throttle-debounce": "5.0.2",
		"typescript": "5.8.3",
		"unplugin": "^2.1.2",
		"unplugin-swc": "^1.5.1",
		"vite": "7.1.9",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"author": "",
	"license": "ISC",
	"gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
	"stableVersion": "3.0.0-alpha-2",
	"devDependencies": {
		"vite-bundle-analyzer": "^1.2.3"
	}
}