{
	"name": "@cmmn/tools",
	"version": "3.0.0-alpha-6",
	"description": "Compilation, bundling, code generator, testing.",
	"type": "module",
	"repository": {
		"url": "https://github.com/franzzua/cmmn/tree/master/tools"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/typings/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"./import-dev": "./node/register-dev.js",
			"./test": {
				"types": "./dist/typings/test/test.d.ts",
				"default": "./dist/esm/test/test.js"
			},
			"./vite": {
				"types": "./dist/typings/vite/index.d.ts",
				"default": "./dist/esm/vite/index.js"
			},
			"./vite/client": {
				"types": "./vite/client.d.ts"
			}
		}
	},
	"bin": {
		"cmmn": "dist/esm/bin.js"
	},
	"scripts": {
		"dev": "cd .. && node ./tools/dist/esm/bin.js dev --watch",
		"dev:prod": "cd .. && node ./tools/dist/esm/bin.js dev --prod"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./dist/esm/index.js"
		},
		"./import-dev": "./node/register-dev.js",
		"./test": {
			"types": "./test/test.ts",
			"default": "./dist/esm/test/test.js"
		},
		"./vite": {
			"types": "./vite/index.ts",
			"default": "./dist/esm/vite/index.js"
		},
		"./vite/client": {
			"types": "./vite/client.d.ts"
		}
	},
	"config": {
		"server": true
	},
	"files": [
		"dist/esm/**",
		"dist/typings/**",
		"node",
		"vite/client.d.ts"
	],
	"dependencies": {
		"@biomejs/biome": "1.9.4",
		"@fastify/caching": "9.0.3",
		"@fastify/express": "4.0.2",
		"@fastify/http-proxy": "11.3.0",
		"@manypkg/get-packages": "^2.2.2",
		"@rollup/plugin-wasm": "6.2.2",
		"@schemastore/package": "0.0.10",
		"@types/node": "22.18.9",
		"@yarn-tool/resolve-package": "^2.0.12",
		"builtin-modules": "^5.0.0",
		"expect": "^29.7.0",
		"fast-glob": "^3.3.3",
		"fastify": "5.6.1",
		"http-proxy-middleware": "3.0.5",
		"mime-types": "2.1.35",
		"minimatch": "10.0.3",
		"rolldown": "1.2.13",
		"terminal-kit": "^3.1.2",
		"throttle-debounce": "5.0.2",
		"unplugin": "^2.1.2",
		"vite": "8.3.4"
	},
	"author": "",
	"license": "ISC",
	"gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
	"stableVersion": "3.0.0-alpha-2",
	"devDependencies": {
		"vite-bundle-analyzer": "^1.2.3"
	}
}
