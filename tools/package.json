{
  "name": "@cmmn/tools",
  "version": "3.0.0-alpha-2",
  "description": "Compilation, bundling, code generator, testing.",
  "main": "dist/rollup.config.js",
  "type": "module",
  "repository": {
    "url": "https://github.com/franzzua/cmmn/tree/master/tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cmmn": "bin.js"
  },
  "exports": {
    "./compile/tsconfig.json": "./compile/tsconfig.json",
    "./import": "./node/register.js",
    "./test": "./test/test.ts"
  },
  "typesVersions": {
    "*": {
      "test": [
        "./test/index.d.ts"
      ],
      ".": [
        "./compile/typings.d.ts"
      ]
    }
  },
  "typings": "compile/typings.d.ts",
  "files": [
    "bin.js",
    "commands/**/*",
    "compile/*",
    "node/*",
    "test/*",
    "helpers/*"
  ],
  "dependencies": {
    "@rspack/cli": "^1.1.8",
    "@rspack/core": "1.1.8",
    "@rspack/dev-server": "^1.0.10",
    "@schemastore/package": "0.0.10",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "^0.6.0",
    "@swc/core": "1.10.7",
    "@swc/helpers": "0.5.15",
    "@types/node": "22.8.1",
    "@zerollup/ts-helpers": "1.7.18",
    "chokidar": "4.0.3",
    "expect": "^29.7.0",
    "html-loader": "^5.1.0",
    "import-meta-resolve": "^4.1.0",
    "snowpack": "^3.8.8",
    "unionfs": "^4.5.4"
  },
  "author": "",
  "license": "ISC",
  "gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
  "stableVersion": "3.0.0-alpha-2",
  "devDependencies": {
    "@rslib/core": "^0.3.1"
  }
}
