{
	"name": "@cmmn/tools",
	"version": "3.0.0-beta-2",
	"description": "Compilation, bundling, code generator, testing.",
	"main": "dist/rollup.config.js",
	"type": "module",
	"repository": {
		"url": "https://github.com/franzzua/cmmn/tree/master/tools"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"cmmn": "bin.js"
	},
	"exports": {
		"./compile/tsconfig.json": "./compile/tsconfig.json",
		"./import": "./node/register.js",
		"./test": "./test/test.ts"
	},
	"typesVersions": {
		"*": {
			"test": [
				"./test/index.d.ts"
			],
			".": [
				"./compile/typings.d.ts"
			]
		}
	},
	"typings": "compile/typings.d.ts",
	"files": [
		"bin.js",
		"commands/**/*",
		"compile/*",
		"node/*",
		"test/*",
		"helpers/*",
		"dev-server/*"
	],
	"dependencies": {
		"@biomejs/biome": "1.9.4",
		"@chialab/esbuild-plugin-commonjs": "^0.18.0",
		"@farmfe/core": "^1.6.6",
		"@fastify/express": "^4.0.2",
		"@manypkg/get-packages": "^2.2.2",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rspack/core": "1.2.7",
		"@schemastore/package": "0.0.10",
		"@swc-node/register": "1.10.9",
		"@swc/cli": "^0.6.0",
		"@swc/core": "1.10.7",
		"@swc/helpers": "0.5.15",
		"@types/node": "22.8.1",
		"@zerollup/ts-helpers": "1.7.18",
		"chokidar": "4.0.3",
		"esbuild": "^0.25.0",
		"esbuild-plugin-wasm": "^1.1.0",
		"expect": "^29.7.0",
		"express": "^4.21.2",
		"fast-glob": "^3.3.3",
		"fastify": "5.2.1",
		"html-loader": "^5.1.0",
		"import-meta-resolve": "^4.1.0",
		"memfs": "^4.17.0",
		"mime": "4.0.6",
		"rolldown": "1.0.0-beta.3",
		"terminal-kit": "^3.1.2",
		"unionfs": "^4.5.4",
		"unplugin": "^2.1.2",
		"unplugin-isolated-decl": "0.11.0",
		"unplugin-starter": "^0.1.0",
		"unplugin-swc": "^1.5.1",
		"vite": "6.2.0",
		"vite-plugin-top-level-await": "^1.5.0",
		"vite-plugin-wasm": "^3.4.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"author": "",
	"license": "ISC",
	"gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021",
	"stableVersion": "3.0.0-alpha-2",
	"resolutions": {
		"terser": "npm:@swc/core"
	},
	"devDependencies": {
		"@types/express": "^4"
	}
}