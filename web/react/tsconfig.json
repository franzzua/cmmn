{
  "extends": "@cmmn/tools/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "lib": [
      "dom",
      "es2015.collection",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@cmmn/react"
  },
  "include": [
