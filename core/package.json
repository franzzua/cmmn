{
  "name": "@cmmn/core",
  "version": "2.2.3",
  "repository": {
    "url": "https://github.com/franzzua/cmmn/tree/master/core"
  },
  "description": "di, base extensions, useful functions",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "> 0.25%"
  ],
  "type": "module",
  "main": "./dist/bundle/main.js",
  "module": "./dist/esm/index.js",
  "typings": "./dist/typings/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typings/index.d.ts",
      "module": "./dist/esm/index.js",
      "import": "./dist/bundle/index.js",
      "require": "./dist/bundle/index.cjs",
      "default": "./dist/bundle/index.js"
    }
  },
  "scripts": {
    "build": "cmmn compile --watch",
    "bundle": "cmmn bundle --watch",
    "bundle:min": "cmmn bundle --watch",
    "typings": "cmmn typings --watch",
    "test": "node --test --import @cmmn/tools/import ./**/*.spec.ts"
  },
  "devDependencies": {
    "@cmmn/tools": "workspace:*",
    "throttle-debounce": "5.0.2",
    "uuidv7": "1.0.2"
  },
  "author": "",
  "license": "ISC",
  "cmmn": {
    "index": {
      "input": "dist/esm/index.js",
      "module": "es,cjs",
      "platform": "neutral",
      "external": [
        "@cmmn"
      ]
    }
  }
}
