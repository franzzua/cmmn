{
	"name": "@cmmn/framework",
	"version": "3.0.0-alpha-6",
	"description": "",
	"module": "package.json",
	"private": true,
	"repository": {
		"url": "https://npm.local"
	},
	"config": {
		"host": "cmmn.framework.app",
		"port": "9009",
		"proxy": {
			"^/example/react": "/_/@cmmn/examples-client",
			"^/example/uhtml": "/_/@cmmn/examples-counter"
		}
	},
	"scripts": {
		"init": "yarn && yarn build",
		"build": "tsc -b",
		"compile": "tsc -b --watch",
		"bundle": "tsc -b && yarn workspaces foreach -A -t run bundle",
		"test": "tsc -b && node --test --test-timeout=20000 --test-force-exit \"**/dist/esm/**/*.spec.js\"",
		"release": "yarn bundle && yarn workspaces foreach -A --no-private --topological npm publish --tolerate-republish",
		"publish": "wersion patch",
		"dev": "cmmn dev",
		"dev:prod": "cmmn dev --prod --minify"
	},
	"workspaces": [
		"core",
		"tools",
		"server",
		"web/*",
		"sync",
		"examples/*"
	],
	"author": "",
	"license": "ISC",
	"files": [],
	"devDependencies": {
		"@cmmn/tools": "workspace:~",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	},
	"packageManager": "yarn@4.18.1",
	"stableVersion": "3.0.0-alpha-2"
}
