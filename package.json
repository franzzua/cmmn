{
	"name": "@cmmn/framework",
	"version": "3.0.0-alpha-6",
	"description": "",
	"module": "package.json",
	"private": true,
	"repository": {
		"url": "https://npm.local"
	},
	"config": {
		"host": "cmmn.framework.app",
		"port": "9009",
		"proxy": {
			"^/example/react": "/_/@cmmn/examples-client",
			"^/example/uhtml": "/_/@cmmn/examples-counter"
		}
	},
	"scripts": {
		"init": "yarn && cd tools && yarn run compile && cd .. && yarn",
		"compile": "cmmn compile --watch",
		"bundle": "cmmn bundle --watch",
		"bundle:prod": "cmmn bundle --prod",
		"typings": "cmmn typings --watch",
		"prod": "cmmn bundle --prod",
		"ci2": "cmmn compile && cmmn bundle && cmmn bundle --prod --minify",
		"test": "node --test --import @cmmn/tools/import **/*.spec.ts",
		"publish": "wersion patch",
		"dev": "cmmn dev",
		"dev:prod": "cmmn dev --prod --minify"
	},
	"workspaces": [
		"core",
		"tools",
		"server",
		"web/*",
		"sync",
		"examples/*"
	],
	"author": "",
	"license": "ISC",
	"files": [],
	"devDependencies": {
		"@chainsafe/libp2p-yamux": "^7.0.1",
		"@cmmn/tools": "workspace:~",
		"@types/route-parser": "^0",
		"route-parser": "^0.0.5",
		"typescript": "5.8.3"
	},
	"packageManager": "yarn@4.5.1",
	"stableVersion": "3.0.0-alpha-2"
}
