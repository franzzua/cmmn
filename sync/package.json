{
	"name": "@cmmn/sync",
	"version": "3.0.0-alpha-6",
	"description": "collaborative with loro-crdt",
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/typings/index.d.ts",
				"default": "./dist/bundle/index.js"
			},
			"./storage": {
				"types": "./dist/typings/src/crdt/storage.d.ts",
				"default": "./dist/bundle/storage.js"
			}
		}
	},
	"repository": {
		"url": "https://github.com/franzzua/cmmn/tree/master/sync"
	},
	"scripts": {
		"bundle": "vite build"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./dist/esm/index.js"
		},
		"./storage": {
			"types": "./src/crdt/storage.ts",
			"default": "./dist/esm/src/crdt/storage.js"
		}
	},
	"files": [
		"dist/bundle/**",
		"dist/typings/**",
		"!dist/typings/specs/**",
		"!dist/typings/perf/**"
	],
	"dependencies": {
		"@cmmn/core": "workspace:~",
		"loro-crdt": "1.7.3"
	},
	"devDependencies": {
		"@cmmn/tools": "workspace:~",
		"@libp2p/bootstrap": "11.0.32",
		"@libp2p/floodsub": "10.1.31",
		"@libp2p/identify": "3.0.27",
		"@libp2p/interface-mocks": "12.0.1",
		"@libp2p/memory": "1.1.4",
		"@libp2p/peer-id": "5.1.0",
		"@libp2p/plaintext": "2.0.20",
		"libp2p": "2.8.2"
	},
	"author": "",
	"license": "ISC",
	"type": "module",
	"gitHead": "2755b333808bf97f1d9454601c2a2c9a88e4a021"
}
